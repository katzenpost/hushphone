import { ListView, LineEdit, ComboBox, Spinner, Palette } from "std-widgets.slint";
import { Theme, ThemePreference } from "theme.slint";
import { AppState, Actions, ChatItem, LineItem, MemberItem, Connection, LineKind, Delivery } from "globals.slint";
import { Stable, Icon, IconButton, Button, Avatar, Badge } from "components/controls.slint";
import { MessageRow, NoticeRow } from "components/messages.slint";
import { Dialog, Hint, FieldLabel } from "components/dialog.slint";

export { AppState, Actions, Theme, ThemePreference, Connection, LineKind, Delivery, ChatItem, LineItem, MemberItem }

component ConnectionDot {
    width: 8px;
    height: 8px;
    Rectangle {
        border-radius: 4px;
        background: AppState.connection == Connection.online ? Theme.accent
            : AppState.connection == Connection.connecting || AppState.connection == Connection.offline ? Theme.warn : Theme.danger;
    }
}

component ChatRow {
    in property <ChatItem> chat;
    in property <bool> selected;
    callback activated();
    height: 64px;
    accessible-role: list-item;
    accessible-label: chat.name + (chat.unread > 0 ? ", " + chat.unread + " unread" : "");
    accessible-item-selected: selected;
    accessible-action-default => { if (stable.armed) { root.activated(); } }

    stable := Stable { at: root.absolute-position; settle: 300ms; }

    Rectangle {
        x: Theme.s2;
        width: parent.width - 2 * Theme.s2;
        border-radius: Theme.radius;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }
    }
    HorizontalLayout {
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        spacing: Theme.s3;
        Avatar {
            y: (parent.height - self.height) / 2;
            initial: root.chat.initial;
            tint: root.chat.tint;
            size: 40px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: Theme.s2;
                Text {
                    text: root.chat.name;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 600;
                    overflow: elide;
                    wrap: no-wrap;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.chat.time;
                    color: root.chat.unread > 0 ? Theme.accent : Theme.text-faint;
                    font-size: Theme.fs-small;
                }
            }
            HorizontalLayout {
                spacing: Theme.s2;
                Text {
                    text: root.chat.joining ? "Joining…" : root.chat.preview;
                    color: root.chat.joining ? Theme.warn : Theme.text-muted;
                    font-size: Theme.fs-small;
                    font-italic: root.chat.joining;
                    overflow: elide;
                    wrap: no-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if root.chat.unread > 0: Badge { count: root.chat.unread; }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (stable.armed) { root.activated(); } }
    }
}

component MenuEntry {
    in property <string> text;
    in property <image> icon;
    in property <bool> danger;
    callback activated();
    height: 40px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.activated(); }
    Rectangle {
        border-radius: Theme.radius-sm;
        background: touch.has-hover ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        spacing: Theme.s3;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: 18px;
            tint: root.danger ? Theme.danger : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component Sidebar inherits Rectangle {
    callback open-chat(string);
    callback new-group();
    callback join-group();
    callback settings();
    background: Theme.sidebar;

    VerticalLayout {
        HorizontalLayout {
            padding: Theme.s4;
            padding-right: Theme.s2;
            spacing: Theme.s2;
            height: 64px;
            Icon {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/hush.svg");
                tint: Theme.accent;
                size: 22px;
            }
            Text {
                text: "hushphone";
                color: Theme.text;
                font-size: Theme.fs-title;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/plus.svg");
                label: "New group or join one";
                activated => { menu.show(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/settings.svg");
                label: "Settings";
                activated => { root.settings(); }
            }
        }

        if AppState.chats.length == 0: VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s3;
            alignment: start;
            Hint { text: "No groups yet. Start one, or ask a member of a group for a way in."; }
        }

        ListView {
            vertical-stretch: 1;
            for chat in AppState.chats: ChatRow {
                chat: chat;
                selected: chat.id == AppState.current;
                activated => { root.open-chat(chat.id); }
            }
        }

        Rectangle { height: 1px; background: Theme.divider; }
        HorizontalLayout {
            padding: Theme.s3;
            padding-left: Theme.s4;
            spacing: Theme.s2;
            height: 44px;
            VerticalLayout {
                alignment: center;
                ConnectionDot { }
            }
            Text {
                text: AppState.connection == Connection.online ? "kpclientd is on the mixnet"
                    : AppState.connection == Connection.connecting ? "Connecting to kpclientd…"
                    : AppState.connection == Connection.offline ? "kpclientd is off the mixnet" : "kpclientd unreachable";
                color: Theme.text-muted;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: AppState.my-name;
                color: Theme.text-faint;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                overflow: elide;
                max-width: 120px;
            }
        }
    }

    menu := PopupWindow {
        x: parent.width - 200px - Theme.s2;
        y: 56px;
        width: 200px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: Theme.s1;
                MenuEntry {
                    text: "New group";
                    icon: @image-url("icons/plus.svg");
                    activated => { menu.close(); root.new-group(); }
                }
                MenuEntry {
                    text: "Join a group";
                    icon: @image-url("icons/join.svg");
                    activated => { menu.close(); root.join-group(); }
                }
            }
        }
    }
}

// Hold to talk. Releasing sends; pressing Escape or dragging well away cancels. Space works the
// same while the button has keyboard focus.
component PttButton {
    width: 48px;
    height: 48px;
    accessible-role: button;
    accessible-label: AppState.recording ? "Recording: release to send" : "Hold to record a voice message";
    forward-focus: fs;
    private property <bool> held;

    stable := Stable { at: root.absolute-position; enabled: AppState.current-joined; }

    Rectangle {
        border-radius: self.width / 2;
        background: AppState.recording ? Theme.recording : touch.has-hover ? Theme.hover : Theme.raised;
        animate background { duration: Theme.quick; }
    }
    // A ring that pulses while the microphone is open.
    if AppState.recording: Rectangle {
        border-radius: self.width / 2;
        border-width: 3px;
        border-color: Theme.recording.with-alpha(0.4);
        width: parent.width + 4px + 4px * (1 + sin(animation-tick() / 600ms * 360deg));
        height: self.width;
    }
    Icon {
        icon: @image-url("icons/mic.svg");
        tint: AppState.recording ? #ffffff : Theme.text-muted;
        size: 22px;
    }

    touch := TouchArea {
        enabled: AppState.current-joined;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button != PointerEventButton.left) { return; }
            if (e.kind == PointerEventKind.down && stable.armed && !root.held) {
                root.held = true;
                Actions.ptt-start();
            } else if (e.kind == PointerEventKind.up && root.held) {
                root.held = false;
                Actions.ptt-stop();
            } else if (e.kind == PointerEventKind.cancel && root.held) {
                root.held = false;
                Actions.ptt-cancel();
            }
        }
        moved => {
            if (root.held && (abs(self.mouse-x - self.width / 2) > 120px || abs(self.mouse-y - self.height / 2) > 120px)) {
                root.held = false;
                Actions.ptt-cancel();
            }
        }
    }
    // Zero-sized, so that it takes keys but never the pointer from the touch area.
    fs := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        enabled: AppState.current-joined;
        key-pressed(e) => {
            if (e.text == " " && !e.repeat) {
                if (stable.armed && !root.held) {
                    root.held = true;
                    Actions.ptt-start();
                }
                return accept;
            }
            if (e.text == Key.Escape && root.held) {
                root.held = false;
                Actions.ptt-cancel();
                return accept;
            }
            reject
        }
        key-released(e) => {
            if (e.text == " " && root.held) {
                root.held = false;
                Actions.ptt-stop();
                return accept;
            }
            reject
        }
    }
}

component Composer inherits Rectangle {
    background: Theme.surface;
    private property <string> draft;
    min-height: lay.preferred-height;

    function send() {
        if (root.draft.is-empty) { return; }
        Actions.send-text(root.draft);
        root.draft = "";
    }

    lay := VerticalLayout {
        Rectangle { height: 1px; background: Theme.divider; }

        if AppState.recording: HorizontalLayout {
            padding: Theme.s3;
            padding-left: Theme.s4;
            spacing: Theme.s3;
            height: 72px;
            // The microphone indicator: shown for exactly as long as capture runs.
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: Theme.recording;
                    opacity: 0.55 + 0.45 * sin(animation-tick() / 500ms * 360deg);
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Recording " + AppState.record-time;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 600;
                }
                Text {
                    text: "release to send to " + AppState.current-name;
                    color: Theme.text-muted;
                    font-size: Theme.fs-small;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/close.svg");
                    label: "Cancel recording";
                    activated => { Actions.ptt-cancel(); }
                }
            }
            VerticalLayout {
                alignment: center;
                PttButton { }
            }
        }

        if !AppState.recording: HorizontalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;
            alignment: stretch;
            IconButton {
                y: parent.height - self.height - Theme.s3 - 4px;
                icon: @image-url("icons/paperclip.svg");
                label: "Attach a file for " + AppState.current-name;
                enabled: AppState.current-joined;
                activated => { Actions.attach-file(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Rectangle {
                    height: min(140px, max(44px, input.preferred-height + 2 * Theme.s3));
                    border-radius: 22px;
                    background: Theme.raised;
                    border-width: input.has-focus ? 2px : 0px;
                    border-color: Theme.focus-ring;
                    clip: true;
                    HorizontalLayout {
                        padding-left: Theme.s4;
                        padding-right: Theme.s4;
                        padding-top: Theme.s3;
                        padding-bottom: Theme.s3;
                        input := TextInput {
                            text <=> root.draft;
                            enabled: AppState.current-joined;
                            single-line: false;
                            wrap: word-wrap;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            selection-background-color: Theme.accent-soft;
                            selection-foreground-color: Theme.text;
                            accessible-label: "Message to " + AppState.current-name;
                            key-pressed(e) => {
                                if (e.text == "\n" && !e.modifiers.shift) {
                                    root.send();
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                    if root.draft.is-empty: Text {
                        x: Theme.s4;
                        text: AppState.current-joined ? "Message" : "Waiting to join…";
                        color: Theme.text-faint;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                    }
                }
                // The destination of a send, next to the control that sends.
                Text {
                    text: "to " + AppState.current-name;
                    color: Theme.text-faint;
                    font-size: 0.72rem;
                    overflow: elide;
                }
            }
            if root.draft.is-empty: PttButton { y: (parent.height - self.height) / 2 - 6px; }
            if !root.draft.is-empty: Rectangle {
                width: 48px;
                height: 48px;
                y: (parent.height - self.height) / 2 - 6px;
                border-radius: 24px;
                background: send-touch.has-hover ? Theme.accent-hover : Theme.accent;
                accessible-role: button;
                accessible-label: "Send to " + AppState.current-name;
                accessible-action-default => { if (send-stable.armed) { root.send(); } }
                send-stable := Stable { at: parent.absolute-position; }
                Icon { icon: @image-url("icons/send.svg"); tint: Theme.on-accent; size: 20px; }
                send-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { if (send-stable.armed) { root.send(); } }
                }
            }
        }
    }
}

component JoiningPanel {
    // Placed by hand at a known width, so its wrapped text is measured at that width. The code is
    // a direct child of the layout for the same reason; its background follows its bounds.
    card := Rectangle {
        width: min(520px, root.width - 2 * Theme.s4);
        height: lay.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(Theme.s4, (root.height - self.height) / 2);
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.divider;

        Rectangle {
            x: code.x - Theme.s3;
            y: code.y - Theme.s3;
            width: code.width + 2 * Theme.s3;
            height: code.height + 2 * Theme.s3;
            visible: !AppState.minting;
            background: Theme.raised;
            border-radius: Theme.radius-sm;
        }

        lay := VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s3;
            Text {
                text: "Joining " + AppState.current-name;
                color: Theme.text;
                font-size: Theme.fs-title;
                font-weight: 700;
                overflow: elide;
            }
            if AppState.minting: HorizontalLayout {
                spacing: Theme.s3;
                Spinner { indeterminate: true; width: 24px; height: 24px; }
                Hint { text: "Minting a voucher over the mixnet. This can take a minute."; vertical-alignment: center; }
            }
            if !AppState.minting: Hint { text: "Give this voucher code to someone already in the group, over a channel you trust. When they add it, you join."; }
            Rectangle { height: AppState.minting ? 0 : Theme.s2; }
            code := Text {
                text: AppState.minting ? "" : AppState.code;
                visible: !AppState.minting;
                color: Theme.text;
                font-family: "monospace";
                font-size: Theme.fs-small;
                wrap: word-wrap;
                accessible-label: "voucher code";
            }
            Rectangle { height: AppState.minting ? 0 : Theme.s2; }
            if !AppState.minting: HorizontalLayout {
                alignment: start;
                Button {
                    text: "Copy code";
                    icon: @image-url("icons/copy.svg");
                    has-icon: true;
                    primary: true;
                    activated => { Actions.copy-code(); }
                }
            }
        }
    }
}

component Conversation inherits Rectangle {
    in property <bool> narrow;
    callback back();
    callback members();
    callback invite();
    callback rename();
    callback clear();
    callback leave();
    background: Theme.bg;

    VerticalLayout {
        // The header is the app's: the group name here is the one this user gave it.
        Rectangle {
            height: 64px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: root.narrow ? Theme.s1 : Theme.s4;
                padding-right: Theme.s2;
                spacing: Theme.s2;
                if root.narrow: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/back.svg");
                    label: "Back to groups";
                    activated => { root.back(); }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: AppState.current-name;
                        color: Theme.text;
                        font-size: Theme.fs-title;
                        font-weight: 700;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    Text {
                        text: !AppState.current-joined ? "joining…"
                            : AppState.adding ? "adding a member…"
                            : AppState.current-members == 1 ? "1 other member" : AppState.current-members + " other members";
                        color: Theme.text-muted;
                        font-size: Theme.fs-small;
                        overflow: elide;
                    }
                }
                if AppState.current-joined: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/user-plus.svg");
                    label: "Add a member to " + AppState.current-name;
                    enabled: !AppState.adding;
                    activated => { root.invite(); }
                }
                if AppState.current-joined: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/users.svg");
                    label: "Members of " + AppState.current-name;
                    activated => { root.members(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/more.svg");
                    label: "More for " + AppState.current-name;
                    activated => { more.show(); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
        }

        if !AppState.current-joined: JoiningPanel { vertical-stretch: 1; }

        if AppState.current-joined: messages := ListView {
            vertical-stretch: 1;
            for line in AppState.lines: VerticalLayout {
                if line.kind == LineKind.notice: NoticeRow { text: line.text; }
                if line.kind != LineKind.notice: MessageRow { line: line; }
            }
        }

        if AppState.current-joined: Composer { }
    }

    more := PopupWindow {
        x: parent.width - 220px - Theme.s2;
        y: 56px;
        width: 220px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: Theme.s1;
                MenuEntry {
                    text: "Rename";
                    icon: @image-url("icons/settings.svg");
                    activated => { more.close(); root.rename(); }
                }
                if AppState.current-joined: MenuEntry {
                    text: "Check for messages";
                    icon: @image-url("icons/search.svg");
                    activated => { more.close(); Actions.scan(); }
                }
                MenuEntry {
                    text: "Clear history";
                    icon: @image-url("icons/close.svg");
                    activated => { more.close(); root.clear(); }
                }
                MenuEntry {
                    text: "Leave group";
                    icon: @image-url("icons/join.svg");
                    danger: true;
                    activated => { more.close(); root.leave(); }
                }
            }
        }
    }
}

component Welcome inherits Rectangle {
    callback new-group();
    callback join-group();
    background: Theme.bg;
    VerticalLayout {
        alignment: center;
        spacing: Theme.s4;
        padding: Theme.s5;
        HorizontalLayout {
            alignment: center;
            Icon { icon: @image-url("icons/hush.svg"); tint: Theme.accent; size: 56px; }
        }
        Text {
            text: "Group chat over the Katzenpost mixnet";
            color: Theme.text;
            font-size: Theme.fs-heading;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "Messages, files and voice travel through the mixnet and are stored by its replicas. No server sees who talks to whom.";
            color: Theme.text-muted;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: Theme.s3;
            Button {
                text: "New group";
                icon: @image-url("icons/plus.svg");
                has-icon: true;
                primary: true;
                activated => { root.new-group(); }
            }
            Button {
                text: "Join a group";
                icon: @image-url("icons/join.svg");
                has-icon: true;
                activated => { root.join-group(); }
            }
        }
    }
}

component NameDialog inherits Dialog {
    in property <string> label;
    in property <string> hint;
    in property <string> action;
    in-out property <string> value;
    callback submitted(string);
    VerticalLayout {
        spacing: Theme.s2;
        FieldLabel { text: root.label; }
        field := LineEdit {
            text <=> root.value;
            accepted => { if (!root.value.is-empty) { root.submitted(root.value); } }
        }
        Hint { text: root.hint; }
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.s2;
        Button { text: "Cancel"; activated => { root.dismissed(); } }
        Button {
            text: root.action;
            primary: true;
            enabled: !root.value.is-empty;
            activated => { root.submitted(root.value); }
        }
    }
    init => { field.focus(); }
}

component ConfirmDialog inherits Dialog {
    in property <string> body;
    in property <string> action;
    callback confirmed();
    Hint { text: root.body; font-size: Theme.fs-body; }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.s2;
        // The safe choice has the focus; the dangerous one ignores input until it has settled.
        cancel := Button { text: "Cancel"; activated => { root.dismissed(); } }
        Button {
            text: root.action;
            danger: true;
            settle: 700ms;
            activated => { root.confirmed(); }
        }
    }
    init => { cancel.focus(); }
}

component MembersDialog inherits Dialog {
    callback rename-member(MemberItem);
    callback remove-member(MemberItem);
    panel-width: 460px;
    Hint { text: "Names marked ~ are the members' own claims. Give someone a name of your own to tell them apart."; }
    ListView {
        min-height: min(360px, AppState.members.length * 56px + 8px);
        for m in AppState.members: HorizontalLayout {
            height: 56px;
            spacing: Theme.s3;
            Avatar { y: (parent.height - self.height) / 2; initial: m.initial; tint: m.tint; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: m.me ? m.name + " (you)" : m.petname != "" ? m.petname : m.name;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: m.petname != "" ? 700 : 400;
                    overflow: elide;
                    wrap: no-wrap;
                }
                Text {
                    text: m.petname != "" ? "calls themself " + m.name + " · ~" + m.fingerprint : "~" + m.fingerprint + " · unverified name";
                    color: Theme.text-faint;
                    font-size: Theme.fs-small;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }
            if !m.me: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                icon: @image-url("icons/settings.svg");
                label: "Name " + m.name + " yourself";
                activated => { root.rename-member(m); }
            }
            if !m.me: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                icon: @image-url("icons/close.svg");
                label: "Stop reading " + m.name;
                tint: Theme.danger;
                tint-active: Theme.danger;
                activated => { root.remove-member(m); }
            }
        }
    }
}

component SettingsDialog inherits Dialog {
    in-out property <string> daemon: AppState.daemon;
    panel-width: 460px;
    GridLayout {
        spacing: Theme.s3;
        Row {
            FieldLabel { text: "Your name"; vertical-alignment: center; }
            Text {
                text: AppState.my-name;
                color: Theme.text;
                font-size: Theme.fs-body;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Row {
            FieldLabel { text: "kpclientd"; vertical-alignment: center; }
            LineEdit { text <=> root.daemon; placeholder-text: "@katzenpost or 127.0.0.1:64331"; }
        }
        Row {
            FieldLabel { text: "Theme"; vertical-alignment: center; }
            ComboBox {
                model: ["System", "Light", "Dark"];
                current-index: Theme.preference == ThemePreference.light ? 1 : Theme.preference == ThemePreference.dark ? 2 : 0;
                selected(v) => {
                    Theme.preference = self.current-index == 1 ? ThemePreference.light : self.current-index == 2 ? ThemePreference.dark : ThemePreference.system;
                }
            }
        }
    }
    Hint { text: "Members see the name you chose when hushphone first started. A new daemon address is used the next time hushphone starts. Press F10 to hide the window's contents at once."; }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.s2;
        Button { text: "Cancel"; activated => { root.dismissed(); } }
        Button {
            text: "Save";
            primary: true;
            activated => {
                Actions.save-settings(root.daemon);
                root.dismissed();
            }
        }
    }
}

export enum Overlay { none, first-run, new-group, join, invite, members, settings, rename, petname, confirm-leave, confirm-clear, confirm-remove }

export component AppWindow inherits Window {
    title: AppState.current-name == "" ? "hushphone" : AppState.current-name + " — hushphone";
    icon: @image-url("icons/hush.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 15px;

    in-out property <Overlay> overlay;
    in-out property <bool> show-conversation;
    in-out property <bool> blanked;
    private property <bool> narrow: root.width < Theme.breakpoint;
    private property <MemberItem> target;

    FocusScope {
        capture-key-pressed(e) => {
            if (e.text == Key.F10) {
                root.blanked = !root.blanked;
                return accept;
            }
            reject
        }

        // Placed by hand rather than in a layout: which panes exist depends on the width, and a
        // layout's minimum width would in turn depend on them.
        Sidebar {
            x: 0;
            y: 0;
            width: root.narrow ? root.width : 320px;
            height: root.height;
            visible: !root.narrow || !root.show-conversation;
            open-chat(id) => {
                Actions.select-chat(id);
                root.show-conversation = true;
            }
            new-group => { root.overlay = Overlay.new-group; }
            join-group => { root.overlay = Overlay.join; }
            settings => { root.overlay = Overlay.settings; }
        }
        Rectangle {
            x: 320px;
            y: 0;
            width: 1px;
            height: root.height;
            visible: !root.narrow;
            background: Theme.divider;
        }
        if AppState.current != "": Conversation {
            x: root.narrow ? 0 : 321px;
            y: 0;
            width: root.narrow ? root.width : root.width - 321px;
            height: root.height;
            visible: !root.narrow || root.show-conversation;
            narrow: root.narrow;
            back => { root.show-conversation = false; }
            members => { root.overlay = Overlay.members; }
            invite => { root.overlay = Overlay.invite; }
            rename => { root.overlay = Overlay.rename; }
            clear => { root.overlay = Overlay.confirm-clear; }
            leave => { root.overlay = Overlay.confirm-leave; }
        }
        if AppState.current == "": Welcome {
            x: 321px;
            y: 0;
            width: root.width - 321px;
            height: root.height;
            visible: !root.narrow;
            new-group => { root.overlay = Overlay.new-group; }
            join-group => { root.overlay = Overlay.join; }
        }

        // Notices from the host never take focus or open a dialog: a strip at the bottom.
        if AppState.notice != "": Rectangle {
            y: parent.height - self.height - Theme.s4;
            x: (parent.width - self.width) / 2;
            width: min(560px, parent.width - 2 * Theme.s4);
            height: toast.preferred-height;
            border-radius: Theme.radius;
            background: AppState.notice-error ? Theme.danger-soft : Theme.surface;
            border-width: 1px;
            border-color: AppState.notice-error ? Theme.danger : Theme.divider;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000030;
            toast := HorizontalLayout {
                padding: Theme.s3;
                padding-left: Theme.s4;
                spacing: Theme.s3;
                Icon {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/alert.svg");
                    tint: AppState.notice-error ? Theme.danger : Theme.accent;
                    size: 18px;
                }
                Text {
                    text: AppState.notice;
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    size: 28px;
                    icon: @image-url("icons/close.svg");
                    label: "Dismiss";
                    activated => { Actions.dismiss-notice(); }
                }
            }
        }

        if root.overlay == Overlay.first-run: NameDialog {
            title: "Welcome to hushphone";
            label: "Your name";
            hint: "Members of your groups see this name next to your messages. It can't be changed later.";
            action: "Continue";
            dismissed => { }
            submitted(v) => {
                Actions.choose-name(v);
                root.overlay = Overlay.none;
            }
        }
        if root.overlay == Overlay.new-group: NameDialog {
            title: "New group";
            label: "Group name";
            hint: "Only you see this name. Members name the group for themselves.";
            action: "Create";
            dismissed => { root.overlay = Overlay.none; }
            submitted(v) => {
                Actions.create-group(v);
                root.overlay = Overlay.none;
                root.show-conversation = true;
            }
        }
        if root.overlay == Overlay.join: NameDialog {
            title: "Join a group";
            label: "What you will call the group";
            hint: "hushphone mints a voucher code over the mixnet. Give it to a member of the group, who adds you with it.";
            action: "Get a voucher";
            dismissed => { root.overlay = Overlay.none; }
            submitted(v) => {
                Actions.join-group(v);
                root.overlay = Overlay.none;
                root.show-conversation = true;
            }
        }
        if root.overlay == Overlay.invite: NameDialog {
            title: "Add a member to " + AppState.current-name;
            label: "Their voucher code";
            hint: "Paste the code the newcomer gave you. They will see the group's members and its messages from now on.";
            action: "Add member";
            dismissed => { root.overlay = Overlay.none; }
            submitted(v) => {
                Actions.invite(v);
                root.overlay = Overlay.none;
            }
        }
        if root.overlay == Overlay.rename: NameDialog {
            title: "Rename group";
            label: "Group name";
            value: AppState.current-name;
            hint: "Only you see this name.";
            action: "Rename";
            dismissed => { root.overlay = Overlay.none; }
            submitted(v) => {
                Actions.rename(v);
                root.overlay = Overlay.none;
            }
        }
        if root.overlay == Overlay.petname: NameDialog {
            title: "Name this member";
            label: "Your name for ~" + root.target.fingerprint;
            value: root.target.petname;
            hint: "They call themself \"" + root.target.name + "\". Your name for them is shown instead, in bold, and only to you.";
            action: "Save";
            dismissed => { root.overlay = Overlay.members; }
            submitted(v) => {
                Actions.set-petname(root.target.key, v);
                root.overlay = Overlay.members;
            }
        }
        if root.overlay == Overlay.members: MembersDialog {
            title: "Members of " + AppState.current-name;
            dismissed => { root.overlay = Overlay.none; }
            rename-member(m) => {
                root.target = m;
                root.overlay = Overlay.petname;
            }
            remove-member(m) => {
                root.target = m;
                root.overlay = Overlay.confirm-remove;
            }
        }
        if root.overlay == Overlay.settings: SettingsDialog {
            title: "Settings";
            dismissed => { root.overlay = Overlay.none; }
        }
        if root.overlay == Overlay.confirm-leave: ConfirmDialog {
            title: "Leave " + AppState.current-name + "?";
            body: "You stop reading and writing this group, and it is removed from this device with its history. Others keep their copies. To come back, someone must add you again.";
            action: "Leave group";
            dismissed => { root.overlay = Overlay.none; }
            confirmed => {
                Actions.leave();
                root.overlay = Overlay.none;
                root.show-conversation = false;
            }
        }
        if root.overlay == Overlay.confirm-clear: ConfirmDialog {
            title: "Clear the history of " + AppState.current-name + "?";
            body: "Every message in this group is deleted from this device. Other members keep theirs. This cannot be undone.";
            action: "Clear history";
            dismissed => { root.overlay = Overlay.none; }
            confirmed => {
                Actions.clear();
                root.overlay = Overlay.none;
            }
        }
        if root.overlay == Overlay.confirm-remove: ConfirmDialog {
            title: "Stop reading " + (root.target.petname != "" ? root.target.petname : root.target.name) + "?";
            body: "You no longer read their messages in " + AppState.current-name + ". They are not told, and other members still read them.";
            action: "Stop reading";
            dismissed => { root.overlay = Overlay.members; }
            confirmed => {
                Actions.remove-member(root.target.key);
                root.overlay = Overlay.members;
            }
        }

        if root.blanked: Rectangle {
            background: Theme.bg;
            TouchArea { }
            Text {
                text: "Hidden. Press F10 to show hushphone again.";
                color: Theme.text-faint;
                font-size: Theme.fs-body;
            }
        }
    }
}
