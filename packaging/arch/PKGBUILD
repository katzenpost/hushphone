# Maintainer: Katzenpost <packages@katzenpost.network>
pkgname=hushphone
pkgver=0.3.6
pkgrel=1
pkgdesc='Group chat with push-to-talk voice over the Katzenpost mixnet'
arch=('x86_64' 'aarch64')
url='https://github.com/katzenpost/hushphone'
license=('AGPL-3.0-only')
# libGL, libEGL, wayland, X11 and xkbcommon are opened with dlopen, so namcap does not see them.
depends=('alsa-lib' 'fontconfig' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libx11' 'libxcursor' 'libxi'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland')
makedepends=('cargo' 'pkgconf')
# No debug package: its debug info takes the build past 6 GB of memory.
# makepkg's -flto turns highctidh's C objects into GCC bitcode that rustc's lld cannot link.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e322a722aa312282357a6a19357ae29b5437c255bb4d553f780f3a3ac61b8c9c')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/hushphone -t "$pkgdir/usr/bin"
  install -Dm644 packaging/network.katzenpost.hushphone.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/network.katzenpost.hushphone.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
}
